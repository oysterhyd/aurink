# Text is stored and checked out with LF on every platform, so gofmt and
# byte-level tests see the same files on Windows runners (core.autocrlf=true).
* text=auto eol=lf

# The fidelity corpus and golden files must stay byte-exact: CRLF, mixed line
# endings, BOMs and missing final newlines are what they test.
**/testdata/** -text

*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.icns   binary
*.ttf    binary
*.otf    binary
*.woff2  binary
*.syso   binary
